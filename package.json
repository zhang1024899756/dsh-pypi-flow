{
  "name": "dsh-pypi-flow",
  "version": "0.1.1",
  "description": "PyPI workflow for DeepSeek Harness: query packages and releases, publish distributions with a built-in zero-dependency uploader, verify names, manage account credentials in settings, and keep a tracked list of your own projects",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    }
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "pypi",
    "python",
    "package",
    "publish",
    "wheel",
    "sdist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhang1024899756/dsh-pypi-flow"
  },
  "homepage": "https://github.com/zhang1024899756/dsh-pypi-flow#readme",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node tests/smoke.mjs",
    "check": "node --check index.js && node --check client.js"
  }
}
